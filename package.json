{
  "name": "skaut-handbook-web-admin",
  "version": "3.0.6",
  "description": "A web administration interface for a Scout handbook",
  "keywords": [
    "education",
    "handbook",
    "odymaterialy",
    "scout",
    "skaut"
  ],
  "homepage": "https://github.com/scout-handbook/handbook-web-admin",
  "bugs": {
    "url": "https://github.com/scout-handbook/handbook-web-admin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scout-handbook/handbook-web-admin.git"
  },
  "license": "MIT",
  "author": "Marek Dědič",
  "type": "module",
  "exports": {
    ".": null
  },
  "sideEffects": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "vite build",
    "postbuild": "node scripts/fix-overflow-shorthand.js",
    "check": "FORCE_COLOR=1 run-p -c --aggregate-output check:*",
    "check:css-compat": "node scripts/check-css-compat.js",
    "check:js-compat": "es-check es2021 --module --checkFeatures 'dist/**/*.js'",
    "clean": "rimraf dist/*",
    "lint": "FORCE_COLOR=1 run-p -c --aggregate-output lint:*",
    "lint:css": "FORCE_COLOR=1 run-p -c --aggregate-output lint:css:*",
    "lint:css:stylelint": "stylelint --report-needless-disables 'src/**/*.css' 'static/**/*.css' '!src/lib/font/fontello.css'",
    "lint:eslint": "eslint",
    "lint:svelte": "FORCE_COLOR=1 run-p -c --aggregate-output lint:svelte:*",
    "lint:svelte:svelte-check": "svelte-check",
    "lint:ts": "FORCE_COLOR=1 run-p -c --aggregate-output lint:ts:*",
    "lint:ts:typecheck": "tsc --noEmit",
    "prepare": "svelte-kit sync",
    "start": "vite"
  },
  "browserslist": [
    "baseline 2020"
  ],
  "dependencies": {
    "easymde": "^2.21.0",
    "showdown": "^2.1.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@fontsource/open-sans": "^5.3.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tanstack/svelte-query": "^6.1.45",
    "@types/codemirror": "5.60.18",
    "@types/node": "^26.4.1",
    "@types/showdown": "^2.0.6",
    "autoprefixer": "^10.5.4",
    "doiuse": "^6.0.6",
    "es-check": "^9.6.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-package-json": "^1.8.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.26",
    "postcss-custom-properties": "^15.0.0",
    "postcss-overflow-shorthand": "^7.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "rimraf": "^6.1.3",
    "rollup-plugin-htaccess": "^0.13.2",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  }
}
